<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t('app_name') %> - <%= t('auth.sign_in') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="text-end mb-3">
        <%= link_to "English", switch_locale_path(locale: :en), class: "btn btn-sm btn-outline-secondary me-1 #{'active' if I18n.locale == :en}" %>
        <%= link_to "日本語", switch_locale_path(locale: :ja), class: "btn btn-sm btn-outline-secondary #{'active' if I18n.locale == :ja}" %>
      </div>
      <div class="row justify-content-center">
        <div class="col-md-5">
          <%= yield %>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
