<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Products</h1>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Export CSV", export_admin_products_path, class: "btn btn-outline-success btn-sm" %>
    <%= link_to "Import CSV", "#importModal", data: { bs_toggle: "modal" }, class: "btn btn-outline-info btn-sm" %>
    <%= link_to "New Product", new_admin_product_path, class: "btn btn-primary" %>
  </div>
</div>

<%= form_with url: admin_products_path, method: :get, class: "card mb-4" do |f| %>
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-md-2">
        <%= f.text_field :q, value: params[:q], class: "form-control", placeholder: "Search..." %>
      </div>
      <div class="col-md-2">
        <%= f.select :status, [["All statuses", ""], ["Active", "active"], ["Draft", "draft"], ["Archived", "archived"]], { selected: params[:status] }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.select :category_id, options_from_collection_for_select(Category.order(:name), :id, :name, params[:category_id]), { include_blank: "All categories" }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.number_field :min_price, value: params[:min_price], class: "form-control", placeholder: "Min price" %>
      </div>
      <div class="col-md-2">
        <%= f.number_field :max_price, value: params[:max_price], class: "form-control", placeholder: "Max price" %>
      </div>
      <div class="col-md-2 ms-md-auto text-md-end">
        <%= f.submit "Filter", class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<%= form_with url: bulk_action_admin_products_path, method: :post, id: "bulk-form" do |f| %>
  <div class="card mb-4">
    <div class="card-body py-2">
      <div class="d-flex gap-2 align-items-center flex-wrap">
        <span class="text-muted small">Bulk actions:</span>
        <%= f.hidden_field :bulk_action, value: "update", id: "bulk_action_type" %>
        <%= f.select :bulk_status, [["-- Update status --", ""], ["Active", "active"], ["Draft", "draft"], ["Archived", "archived"]], {}, class: "form-select form-select-sm w-auto" %>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Update status</button>
        <button type="button" class="btn btn-sm btn-outline-danger" onclick="if(confirm('Delete selected products?')){ document.getElementById('bulk_action_type').value='destroy'; document.getElementById('bulk-form').submit(); }">Delete selected</button>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
  <table class="table table-striped table-hover mb-0">
    <thead>
      <tr>
        <th><input type="checkbox" id="select-all" aria-label="Select all"></th>
        <th>Image</th>
        <th>Name</th>
        <th>Slug</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr class="<%= 'table-warning' if product.stock_quantity <= 5 && product.stock_quantity.positive? %><%= 'table-danger' if product.stock_quantity.zero? %>">
          <td><%= check_box_tag "product_ids[]", product.id, false, id: "product_#{product.id}" %></td>
          <td>
            <% if product.images.attached? %>
              <a href="#" class="d-inline-block" data-bs-toggle="modal" data-bs-target="#productImageModal" data-img-src="<%= url_for(product.images.first) %>" data-product-name="<%= product.name %>">
                <%= image_tag product.images.first, class: "img-thumbnail product-thumb", style: "width: 50px; height: 50px; object-fit: cover; display: block; cursor: pointer;" %>
              </a>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td><%= product.name %></td>
          <td><%= product.slug %></td>
          <td><%= number_to_currency(product.price / 100.0) %></td>
          <td>
            <span class="<%= 'text-danger fw-bold' if product.stock_quantity <= 5 %>"><%= product.stock_quantity %></span>
          </td>
          <td>
            <span class="badge bg-<%= product.status == 'active' ? 'success' : (product.status == 'draft' ? 'warning text-dark' : 'secondary') %>">
              <%= product.status %>
            </span>
          </td>
          <td>
            <div class="d-flex gap-2 flex-wrap align-items-center">
              <% if product.status == "active" && product.stock_quantity.positive? %>
                <%= link_to "Add to cart", admin_cart_add_path(product_id: product.id), data: { turbo_method: :post }, class: "btn btn-sm btn-success" %>
              <% end %>
              <%= link_to "View", admin_product_path(product), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Delete", admin_product_path(product), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
      </div>
    </div>
  </div>
<% end %>

<div class="d-flex justify-content-center mt-3">
  <%= paginate @products %>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: import_admin_products_path, method: :post, local: true, multipart: true do |f| %>
        <div class="modal-header">
          <h5 class="modal-title">Import Products (CSV)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">CSV should have columns: name, slug, description, price, status, stock_quantity, categories (semicolon-separated)</p>
          <%= f.file_field :file, accept: ".csv", class: "form-control" %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Product image zoom modal (index) -->
<div class="modal fade" id="productImageModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="productImageModalTitle">Product image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center p-3">
        <img id="productImageModalImg" src="" alt="Product" class="img-fluid rounded" style="max-height: 70vh;">
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('select-all')?.addEventListener('change', function() {
    document.querySelectorAll('#bulk-form input[name="product_ids[]"]').forEach(cb => cb.checked = this.checked);
  });
  document.querySelectorAll('a[data-bs-target="#productImageModal"]').forEach(el => {
    el.addEventListener('click', function() {
      document.getElementById('productImageModalImg').src = this.dataset.imgSrc;
      document.getElementById('productImageModalTitle').textContent = this.dataset.productName || 'Product image';
    });
  });
</script>
