<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><%= t('users.title') %></h1>
  <%= link_to t('users.new_user'), new_admin_user_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
<table class="table table-striped table-hover mb-0">
  <thead>
    <tr>
      <th><%= t('columns.name') %></th>
      <th><%= t('columns.email') %></th>
      <th><%= t('users.roles') %></th>
      <th><%= t('common.actions') %></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.roles.pluck(:name).join(", ") %></td>
        <td>
          <div class="d-flex gap-2 flex-wrap align-items-center">
            <%= link_to t('common.edit'), edit_admin_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
            <% if user.id != current_user.id %>
              <%= button_to t('common.delete'), admin_user_path(user), method: :delete, form: { data: { turbo_confirm: t('common.confirm_delete') } }, class: "btn btn-sm btn-outline-danger" %>
            <% else %>
              <span class="text-muted small">(<%= t('users.you') %>)</span>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
    </div>
  </div>
</div>

<div class="d-flex justify-content-center mt-3">
  <%= paginate @users %>
</div>
