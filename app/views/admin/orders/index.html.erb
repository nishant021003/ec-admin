<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><%= t('orders.title') %></h1>
  <%= link_to t('orders.export_csv'), export_admin_orders_path, class: "btn btn-outline-success" %>
</div>

<%= form_with url: admin_orders_path, method: :get, class: "card mb-4" do |f| %>
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-md-3">
        <%= f.select :status, [[t('orders.all_statuses'), ""], [t('status.pending'), "pending"], [t('status.processing'), "processing"], [t('status.shipped'), "shipped"], [t('status.delivered'), "delivered"], [t('status.cancelled'), "cancelled"]], { selected: params[:status] }, class: "form-select" %>
      </div>
      <div class="col-md-2 ms-md-auto text-md-end">
        <%= f.submit t('common.filter'), class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
<table class="table table-striped table-hover mb-0">
  <thead>
    <tr>
      <th><%= t('columns.id') %></th>
      <th><%= t('columns.customer') %></th>
      <th><%= t('columns.status') %></th>
      <th><%= t('columns.total') %></th>
      <th><%= t('columns.created') %></th>
      <th><%= t('common.actions') %></th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.id %></td>
        <td><%= order.customer&.name || "—" %></td>
        <td>
          <span class="badge bg-<%= case order.status
            when 'pending' then 'secondary'
            when 'processing' then 'info'
            when 'shipped' then 'primary'
            when 'delivered' then 'success'
            when 'cancelled' then 'danger'
            else 'secondary'
            end %>"><%= translate_status(order.status) %></span>
        </td>
        <td><%= number_to_currency(order.final_amount / 100.0) %></td>
        <td><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td>
          <div class="d-flex gap-2">
            <%= link_to t('common.view'), admin_order_path(order), class: "btn btn-sm btn-outline-primary" %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
    </div>
  </div>
</div>

<div class="d-flex justify-content-center mt-3">
  <%= paginate @orders %>
</div>
