<h1 class="mb-4"><%= t('dashboard.title') %></h1>

<% if @low_stock_count.positive? %>
  <div class="alert alert-warning mb-4">
    <strong><%= t('dashboard.low_stock_alert') %>:</strong> <%= t('dashboard.products_low_stock', count: @low_stock_count) %>
    <%= link_to t('dashboard.view_products'), admin_products_path, class: "alert-link" %>
  </div>
<% end %>

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.orders') %></h5>
        <p class="card-text display-6"><%= @total_orders %></p>
        <%= link_to t('dashboard.view_orders'), admin_orders_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.products') %></h5>
        <p class="card-text display-6"><%= @total_products %></p>
        <%= link_to t('dashboard.view_products'), admin_products_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.customers') %></h5>
        <p class="card-text display-6"><%= @total_customers %></p>
        <%= link_to t('dashboard.view_customers'), admin_customers_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.categories') %></h5>
        <p class="card-text display-6"><%= @total_categories %></p>
        <%= link_to t('dashboard.view_categories'), admin_categories_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.coupons') %></h5>
        <p class="card-text display-6"><%= @total_coupons %></p>
        <%= link_to t('dashboard.view_coupons'), admin_coupons_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('dashboard.gift_cards') %></h5>
        <p class="card-text display-6"><%= @total_gift_cards %></p>
        <%= link_to t('dashboard.view_gift_cards'), admin_gift_cards_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-8 mb-4">
    <div class="card">
      <div class="card-header"><%= t('dashboard.orders_last_7_days') %></div>
      <div class="card-body">
        <canvas id="ordersChart" height="120"></canvas>
      </div>
    </div>
  </div>
  <div class="col-md-4 mb-4">
    <div class="card">
      <div class="card-header"><%= t('page_titles.recent_orders') %></div>
      <ul class="list-group list-group-flush">
        <% @recent_orders.each do |order| %>
          <li class="list-group-item d-flex justify-content-between">
            <%= link_to "Order ##{order.id}", admin_order_path(order) %>
            <span class="badge bg-secondary"><%= order.status %></span>
          </li>
        <% end %>
        <% if @recent_orders.empty? %>
          <li class="list-group-item text-muted"><%= t('page_titles.no_orders') %></li>
        <% end %>
      </ul>
      <div class="card-footer bg-transparent">
        <%= link_to "#{t('page_titles.view_all_orders')} →", admin_orders_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  (function() {
    const data = <%= raw @orders_by_day_7.sort.map { |k, v| { date: k.to_s, count: v } }.to_json %>;
    const labels = data.map(d => d.date);
    const values = data.map(d => d.count);
    if (labels.length === 0) {
      labels.push(new Date().toISOString().slice(0,10));
      values.push(0);
    }
    const ctx = document.getElementById('ordersChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: '<%= j t('dashboard.orders') %>',
            data: values,
            backgroundColor: 'rgba(13, 110, 253, 0.5)',
            borderColor: 'rgb(13, 110, 253)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: { beginAtZero: true }
          }
        }
      });
    }
  })();
</script>
