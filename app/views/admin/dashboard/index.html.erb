<h1 class="mb-4">Dashboard</h1>

<% if @low_stock_count.positive? %>
  <div class="alert alert-warning mb-4">
    <strong>Low stock alert:</strong> <%= @low_stock_count %> product(s) have 5 or fewer items in stock.
    <%= link_to "View products", admin_products_path, class: "alert-link" %>
  </div>
<% end %>

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Orders</h5>
        <p class="card-text display-6"><%= @total_orders %></p>
        <%= link_to "View orders", admin_orders_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Products</h5>
        <p class="card-text display-6"><%= @total_products %></p>
        <%= link_to "View products", admin_products_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Customers</h5>
        <p class="card-text display-6"><%= @total_customers %></p>
        <%= link_to "View customers", admin_customers_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Categories</h5>
        <p class="card-text display-6"><%= @total_categories %></p>
        <%= link_to "View categories", admin_categories_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Coupons</h5>
        <p class="card-text display-6"><%= @total_coupons %></p>
        <%= link_to "View coupons", admin_coupons_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Gift cards</h5>
        <p class="card-text display-6"><%= @total_gift_cards %></p>
        <%= link_to "View gift cards", admin_gift_cards_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-8 mb-4">
    <div class="card">
      <div class="card-header">Orders (last 7 days)</div>
      <div class="card-body">
        <canvas id="ordersChart" height="120"></canvas>
      </div>
    </div>
  </div>
  <div class="col-md-4 mb-4">
    <div class="card">
      <div class="card-header">Recent orders</div>
      <ul class="list-group list-group-flush">
        <% @recent_orders.each do |order| %>
          <li class="list-group-item d-flex justify-content-between">
            <%= link_to "Order ##{order.id}", admin_order_path(order) %>
            <span class="badge bg-secondary"><%= order.status %></span>
          </li>
        <% end %>
        <% if @recent_orders.empty? %>
          <li class="list-group-item text-muted">No orders yet</li>
        <% end %>
      </ul>
      <div class="card-footer bg-transparent">
        <%= link_to "View all orders →", admin_orders_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  (function() {
    const data = <%= raw @orders_by_day_7.sort.map { |k, v| { date: k.to_s, count: v } }.to_json %>;
    const labels = data.map(d => d.date);
    const values = data.map(d => d.count);
    if (labels.length === 0) {
      labels.push(new Date().toISOString().slice(0,10));
      values.push(0);
    }
    const ctx = document.getElementById('ordersChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Orders',
            data: values,
            backgroundColor: 'rgba(13, 110, 253, 0.5)',
            borderColor: 'rgb(13, 110, 253)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          scales: {
            y: { beginAtZero: true }
          }
        }
      });
    }
  })();
</script>
