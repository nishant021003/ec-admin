<%= form_with model: coupon, url: coupon.persisted? ? admin_coupon_path(coupon) : admin_coupons_path, method: coupon.persisted? ? :patch : :post, local: true do |f| %>
  <% if coupon.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% coupon.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :code, class: "form-label" %>
    <%= f.text_field :code, class: "form-control", placeholder: "e.g. SAVE20" %>
    <small class="text-muted">Code will be converted to uppercase</small>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :discount_type, class: "form-label" %>
      <%= f.select :discount_type, [["Percentage (%)", "percentage"], ["Fixed amount ($)", "fixed"]], {}, class: "form-select" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :discount_value, class: "form-label" %>
      <%= f.number_field :discount_value, class: "form-control", min: 0, placeholder: coupon.discount_type == "percentage" ? "e.g. 20" : "e.g. 1000 (cents)" %>
      <small class="text-muted">Percentage: 0-100. Fixed: amount in cents (1000 = $10)</small>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :max_discount, "Max discount (cents)", class: "form-label" %>
      <%= f.number_field :max_discount, class: "form-control", min: 0, placeholder: "Only for percentage, 0 = no cap" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :min_cart_value, "Min cart value (cents)", class: "form-label" %>
      <%= f.number_field :min_cart_value, class: "form-control", min: 0, value: coupon.min_cart_value || 0 %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :usage_limit, class: "form-label" %>
      <%= f.number_field :usage_limit, class: "form-control", min: 1, placeholder: "Leave blank for unlimited" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :per_user_limit, "Per user limit", class: "form-label" %>
      <%= f.number_field :per_user_limit, class: "form-control", min: 1, placeholder: "Leave blank for unlimited" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :expiry_date, class: "form-label" %>
      <%= f.date_field :expiry_date, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, [["Active", "active"], ["Inactive", "inactive"]], {}, class: "form-select" %>
  </div>

  <%= f.submit coupon.persisted? ? "Update Coupon" : "Create Coupon", class: "btn btn-primary" %>
<% end %>
