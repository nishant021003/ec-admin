<%= form_with model: coupon, url: coupon.persisted? ? admin_coupon_path(coupon) : admin_coupons_path, method: coupon.persisted? ? :patch : :post, local: true do |f| %>
  <% if coupon.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% coupon.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :code, t('columns.code'), class: "form-label" %>
    <%= f.text_field :code, class: "form-control", placeholder: "e.g. SAVE20" %>
    <small class="text-muted"><%= t('forms.code_uppercase') %></small>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :discount_type, t('forms.discount_type'), class: "form-label" %>
      <%= f.select :discount_type, [[t('forms.discount_percentage'), "percentage"], [t('forms.discount_fixed'), "fixed"]], {}, class: "form-select" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :discount_value, t('columns.discount'), class: "form-label" %>
      <%= f.number_field :discount_value, class: "form-control", min: 0, placeholder: coupon.discount_type == "percentage" ? "e.g. 20" : "e.g. 1000 (cents)" %>
      <small class="text-muted"><%= t('forms.discount_hint') %></small>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :max_discount, t('forms.max_discount_cents'), class: "form-label" %>
      <%= f.number_field :max_discount, class: "form-control", min: 0, placeholder: t('forms.max_discount_placeholder') %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :min_cart_value, t('forms.min_cart_cents'), class: "form-label" %>
      <%= f.number_field :min_cart_value, class: "form-control", min: 0, value: coupon.min_cart_value || 0 %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :usage_limit, t('coupons.usage_limit'), class: "form-label" %>
      <%= f.number_field :usage_limit, class: "form-control", min: 1, placeholder: t('forms.leave_blank_unlimited') %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :per_user_limit, t('coupons.per_user_limit'), class: "form-label" %>
      <%= f.number_field :per_user_limit, class: "form-control", min: 1, placeholder: t('forms.leave_blank_unlimited') %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, t('coupons.start_date'), class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :expiry_date, t('coupons.expiry_date'), class: "form-label" %>
      <%= f.date_field :expiry_date, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :status, t('columns.status'), class: "form-label" %>
    <%= f.select :status, [[t('status.active'), "active"], [t('status.inactive'), "inactive"]], {}, class: "form-select" %>
  </div>

  <%= f.submit coupon.persisted? ? t('forms.update_coupon') : t('forms.create_coupon'), class: "btn btn-primary" %>
<% end %>
