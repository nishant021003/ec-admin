<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><%= link_to t('nav.coupons'), admin_coupons_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @coupon.code %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><code><%= @coupon.code %></code></h1>
  <div class="d-flex gap-2">
    <%= link_to t('common.edit'), edit_admin_coupon_path(@coupon), class: "btn btn-primary" %>
    <%= button_to t('common.delete'), admin_coupon_path(@coupon), method: :delete, form: { data: { turbo_confirm: t('common.confirm_delete') } }, class: "btn btn-danger" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-2"><%= t('columns.code') %></dt>
      <dd class="col-sm-10"><code><%= @coupon.code %></code></dd>

      <dt class="col-sm-2"><%= t('columns.discount') %></dt>
      <dd class="col-sm-10"><%= @coupon.discount_label %></dd>

      <dt class="col-sm-2"><%= t('coupons.min_cart_value') %></dt>
      <dd class="col-sm-10"><%= @coupon.min_cart_value.positive? ? number_to_currency(@coupon.min_cart_value / 100.0) : t('common.none') %></dd>

      <dt class="col-sm-2"><%= t('coupons.max_discount') %></dt>
      <dd class="col-sm-10"><%= @coupon.max_discount.present? && @coupon.max_discount.positive? ? number_to_currency(@coupon.max_discount / 100.0) : "—" %></dd>

      <dt class="col-sm-2"><%= t('coupons.usage_limit') %></dt>
      <dd class="col-sm-10"><%= @coupon.usage_limit.present? ? @coupon.usage_limit : t('coupons.unlimited') %></dd>

      <dt class="col-sm-2"><%= t('coupons.per_user_limit') %></dt>
      <dd class="col-sm-10"><%= @coupon.per_user_limit.present? ? @coupon.per_user_limit : t('coupons.unlimited') %></dd>

      <dt class="col-sm-2"><%= t('coupons.times_used') %></dt>
      <dd class="col-sm-10"><%= @coupon.coupon_usages.count %></dd>

      <dt class="col-sm-2"><%= t('coupons.start_date') %></dt>
      <dd class="col-sm-10"><%= @coupon.start_date&.strftime("%Y-%m-%d") || "—" %></dd>

      <dt class="col-sm-2"><%= t('coupons.expiry_date') %></dt>
      <dd class="col-sm-10"><%= @coupon.expiry_date&.strftime("%Y-%m-%d") || "—" %></dd>

      <dt class="col-sm-2"><%= t('columns.status') %></dt>
      <dd class="col-sm-10"><span class="badge bg-<%= @coupon.active? ? 'success' : 'secondary' %>"><%= translate_status(@coupon.status) %></span></dd>
    </dl>
  </div>
</div>

<%= link_to "← #{t('coupons.back_to_coupons')}", admin_coupons_path, class: "btn btn-secondary mt-3" %>
