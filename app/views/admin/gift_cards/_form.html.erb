<%= form_with model: gift_card, url: gift_card.persisted? ? admin_gift_card_path(gift_card) : admin_gift_cards_path, method: gift_card.persisted? ? :patch : :post, local: true do |f| %>
  <% if gift_card.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% gift_card.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :code, t('columns.code'), class: "form-label" %>
    <%= f.text_field :code, class: "form-control", placeholder: "e.g. GIFT-XXXX-XXXX" %>
    <small class="text-muted"><%= t('forms.code_uppercase_spaces') %></small>
  </div>

  <div class="mb-3">
    <%= f.label :initial_balance, t('forms.initial_balance_cents'), class: "form-label" %>
    <%= f.number_field :initial_balance, class: "form-control", min: 0, placeholder: "e.g. 5000 = $50.00" %>
    <small class="text-muted"><%= t('forms.balance_hint') %></small>
  </div>

  <% if gift_card.persisted? %>
    <div class="mb-3">
      <%= f.label :balance, t('forms.current_balance_cents'), class: "form-label" %>
      <%= f.number_field :balance, class: "form-control", min: 0 %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :status, t('columns.status'), class: "form-label" %>
    <%= f.select :status, [[t('status.active'), "active"], [t('status.redeemed'), "redeemed"], [t('status.expired'), "expired"]], {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :expiry_date, t('columns.expires'), class: "form-label" %>
    <%= f.date_field :expiry_date, class: "form-control" %>
    <small class="text-muted"><%= t('forms.no_expiry') %></small>
  </div>

  <%= f.submit gift_card.persisted? ? t('forms.update_gift_card') : t('forms.create_gift_card'), class: "btn btn-primary" %>
<% end %>
