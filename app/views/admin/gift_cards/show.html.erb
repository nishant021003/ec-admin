<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><%= link_to "Gift cards", admin_gift_cards_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @gift_card.code %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><code><%= @gift_card.code %></code></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_admin_gift_card_path(@gift_card), class: "btn btn-primary" %>
    <%= button_to "Delete", admin_gift_card_path(@gift_card), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn btn-danger" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-2">Code</dt>
      <dd class="col-sm-10"><code><%= @gift_card.code %></code></dd>

      <dt class="col-sm-2">Initial balance</dt>
      <dd class="col-sm-10"><%= number_to_currency(@gift_card.initial_balance / 100.0) %></dd>

      <dt class="col-sm-2">Current balance</dt>
      <dd class="col-sm-10"><%= number_to_currency(@gift_card.balance / 100.0) %></dd>

      <dt class="col-sm-2">Status</dt>
      <dd class="col-sm-10">
        <span class="badge bg-<%= @gift_card.status == 'active' ? 'success' : (@gift_card.status == 'redeemed' ? 'secondary' : 'danger') %>">
          <%= @gift_card.status %>
        </span>
      </dd>

      <dt class="col-sm-2">Expiry date</dt>
      <dd class="col-sm-10"><%= @gift_card.expiry_date&.strftime("%Y-%m-%d") || "Never" %></dd>

      <dt class="col-sm-2">Redeemable</dt>
      <dd class="col-sm-10"><%= @gift_card.redeemable? ? "Yes" : "No" %></dd>
    </dl>
  </div>
</div>

<%= link_to "← Back to gift cards", admin_gift_cards_path, class: "btn btn-secondary mt-3" %>
