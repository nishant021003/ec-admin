<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Gift cards</h1>
  <%= link_to "New gift card", new_admin_gift_card_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0">
        <thead>
          <tr>
            <th>Code</th>
            <th>Initial balance</th>
            <th>Current balance</th>
            <th>Status</th>
            <th>Expires</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @gift_cards.each do |gc| %>
            <tr>
              <td><code><%= gc.code %></code></td>
              <td><%= number_to_currency(gc.initial_balance / 100.0) %></td>
              <td><%= number_to_currency(gc.balance / 100.0) %></td>
              <td>
                <span class="badge bg-<%= gc.status == 'active' ? 'success' : (gc.status == 'redeemed' ? 'secondary' : 'danger') %>">
                  <%= gc.status %>
                </span>
              </td>
              <td><%= gc.expiry_date&.strftime("%Y-%m-%d") || "—" %></td>
              <td>
                <div class="d-flex gap-2 flex-wrap">
                  <%= link_to "View", admin_gift_card_path(gc), class: "btn btn-sm btn-outline-primary" %>
                  <%= link_to "Edit", edit_admin_gift_card_path(gc), class: "btn btn-sm btn-outline-secondary" %>
                  <%= button_to "Delete", admin_gift_card_path(gc), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn btn-sm btn-outline-danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="d-flex justify-content-center mt-3">
  <%= paginate @gift_cards %>
</div>
