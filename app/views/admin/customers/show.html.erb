<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><%= link_to t('nav.customers'), admin_customers_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @customer.name %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"><%= @customer.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to t('common.edit'), edit_admin_customer_path(@customer), class: "btn btn-primary" %>
    <%= button_to t('common.delete'), admin_customer_path(@customer), method: :delete, form: { data: { turbo_confirm: t('common.confirm_delete') } }, class: "btn btn-danger" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
<dl class="row mb-0">
  <dt class="col-sm-2"><%= t('columns.email') %></dt>
  <dd class="col-sm-10"><%= @customer.email %></dd>

  <dt class="col-sm-2"><%= t('customers.orders') %></dt>
  <dd class="col-sm-10"><%= @customer.orders.count %></dd>
</dl>
  </div>
</div>

<%= link_to "← #{t('customers.back_to_customers')}", admin_customers_path, class: "btn btn-secondary mt-3" %>
