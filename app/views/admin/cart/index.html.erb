<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><%= link_to t('nav.products'), admin_products_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= t('cart.title') %></li>
  </ol>
</nav>

<h1 class="mb-4"><%= t('cart.title') %></h1>

<% if @cart_items.blank? %>
  <div class="alert alert-info">
    <%= t('cart.empty_message') %> <%= link_to t('cart.browse_products'), admin_products_path, class: "alert-link" %>
  </div>
  <%= link_to "← #{t('cart.back_to_products')}", admin_products_path, class: "btn btn-secondary" %>
  <% return %>
<% end %>

<div class="card mb-4">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th><%= t('columns.product') %></th>
          <th><%= t('columns.price') %></th>
          <th><%= t('columns.quantity') %></th>
          <th><%= t('columns.subtotal') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cart_items.each do |item| %>
          <tr class="<%= 'table-success' if item[:is_free_gift] %>">
            <td>
              <%= link_to item[:product].name, admin_product_path(item[:product]), class: "text-decoration-none" %>
              <% if item[:is_free_gift] %>
                <span class="badge bg-info ms-1"><%= t('cart.free_gift') %></span>
              <% end %>
            </td>
            <td><%= item[:is_free_gift] ? t('cart.free') : number_to_currency(item[:product].price / 100.0) %></td>
            <td>
              <%= form_with url: admin_cart_update_path(product_id: item[:product].id), method: :patch, class: "d-inline-flex align-items-center gap-1" do |f| %>
                <%= f.hidden_field :free_gift, value: item[:is_free_gift] ? "1" : "0" %>
                <%= f.number_field :quantity, value: item[:quantity], min: 1, max: item[:is_free_gift] ? 999 : item[:product].stock_quantity, class: "form-control form-control-sm", style: "width: 70px;" %>
                <%= f.submit t('common.update'), class: "btn btn-sm btn-outline-secondary" %>
              <% end %>
            </td>
            <td><%= item[:is_free_gift] ? t('cart.free') : number_to_currency((item[:product].price * item[:quantity]) / 100.0) %></td>
            <td>
              <%= button_to t('common.remove'), admin_cart_remove_path(product_id: item[:product].id, free_gift: item[:is_free_gift] ? "1" : "0"), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: t('cart.remove_from_cart') } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @qualifying_combos.present? %>
    <div class="card-body border-top bg-light">
      <h6 class="mb-2"><%= t('cart.combo_offers') %></h6>
      <% @qualifying_combos.each do |q| %>
        <% combo = q[:combo]; items = q[:items] %>
        <div class="py-2 border-bottom">
          <div class="text-muted small mb-1"><%= combo.display_name %></div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <% items.each do |item| %>
              <%= button_to "#{t('cart.add_free_from_combo')} #{item[:free_qty_to_add]}× #{item[:product].name}",
                            admin_cart_add_path(product_id: item[:product].id),
                            method: :post,
                            params: { free_gift: "1", quantity: item[:free_qty_to_add], return_to: "cart" },
                            class: "btn btn-sm btn-outline-info" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="card-footer d-flex justify-content-between align-items-center">
    <span class="text-muted"><%= t('cart.items_count', count: @cart_items.size) %></span>
    <div>
      <strong><%= t('columns.subtotal') %>: <%= number_to_currency(@subtotal_cents / 100.0) %></strong>
      <%= link_to t('cart.proceed_checkout'), admin_checkout_path, class: "btn btn-primary ms-3" %>
    </div>
  </div>
</div>

<%= link_to "← #{t('cart.continue_shopping')}", admin_products_path, class: "btn btn-secondary" %>
