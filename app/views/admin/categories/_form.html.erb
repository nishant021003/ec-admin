<%= form_with model: category, url: category.persisted? ? admin_category_path(category) : admin_categories_path, method: category.persisted? ? :patch : :post, local: true do |f| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, t('columns.name'), class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :parent_id, t('forms.parent_category'), class: "form-label" %>
    <%= f.collection_select :parent_id, Category.order(:name).where.not(id: category.id), :id, :name, { include_blank: t('common.none') }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :position, t('forms.position'), class: "form-label" %>
    <%= f.number_field :position, class: "form-control", min: 0 %>
  </div>

  <%= f.submit category.persisted? ? t('forms.update_category') : t('forms.create_category'), class: "btn btn-primary" %>
<% end %>
